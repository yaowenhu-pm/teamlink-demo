# Copy to /etc/teamlink/teamlink.env; root owns it with mode 0600.
# Fill on the server through the approved secret setup; never commit actual values.
PUBLIC_ORIGIN=https://teamlink.yaowenhu.cn
DATABASE_PATH=/var/lib/teamlink/rooms.sqlite
HOST=127.0.0.1
PORT=18086
# Explicitly trust only the local Nginx peer; default without this setting is off.
TRUST_PROXY=loopback
# Production must not silently switch the advertised AI experience to command rules.
REQUIRE_AI=true
ROOM_IP_SALT=
CLAW_API_KEY=
CLAW_MODEL=doubao-seed-2.1-lite
# Optional; the existing interpreter only accepts the fixed ClawHunt endpoint.
CLAW_BASE_URL=https://api.clawhunt.site/v1
